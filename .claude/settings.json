{
  "permissions": {
    "allow": [
      "Bash(python3 -I scripts/asc.py status:*)",
      "Bash(python3 -I scripts/asc.py changes:*)",
      "Bash(python3 -I scripts/asc.py review * show)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(xcrun simctl list:*)",
      "Bash(xcrun simctl io * screenshot:*)",
      "Bash(xcodebuild -version)",
      "Bash(xcodebuild -list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-ai-attribution.sh" }
        ]
      }
    ]
  }
}
